{
  "mcpServers": {
    "docs": {
      "url": "https://example.com/mcp",
      "headers": {"Authorization": "Bearer ${DOCS_TOKEN}"}
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {"GITHUB_TOKEN": "${GITHUB_TOKEN}", "GH_HOST": "!echo github.com"}
    },
    "sentry": {"url": "https://mcp.sentry.dev/mcp", "oauth": {"clientName": "Pi"}}
  }
}
