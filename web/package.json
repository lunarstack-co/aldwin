{
  "name": "aldwin-web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-export.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "preview": "node playwright/serve.mjs out 4173",
    "test:e2e": "npm run test:pw",
    "test:pw": "playwright test",
    "test:pw:ui": "playwright test --ui",
    "test:pw:kit": "PW_KIT=1 playwright test --project=kit-light --project=kit-dark",
    "test:pw:timing": "PW_TIMING=1 playwright test --project=chromium-light --project=chromium-dark",
    "test:pw:docker": "scripts/playwright-docker.sh"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.35",
    "@assistant-ui/react-markdown": "^0.14.25",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.23.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
