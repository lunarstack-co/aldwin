# Byte-compiled / cached Python
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts (produced by `uv build`)
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/

# Virtual environments (uv creates .venv here)
.venv/
venv/
env/

# Tooling caches & coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Secrets / local env
.env
.env.*

# E2E transcripts (ENG-433); may contain masked keys but stay local
tests/e2e/out/

# Agent & editor folders
.opencode/
.claude/
.vscode/
.idea/
.DS_Store

# Web UI (web/). Its build output is copied into src/aldwin/web/static/,
# which stays tracked so a Python-only build still ships a page.
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/**/*.tsbuildinfo
web/cypress/screenshots/
web/cypress/videos/
web/cypress/downloads/
